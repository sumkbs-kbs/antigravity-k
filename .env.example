# Ssak-Ai Environment Variables
# =====================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Backend Server ────────────────────────────────────────────
AGK_SERVER_HOST=127.0.0.1
AGK_SERVER_PORT=8400
AGK_RELOAD=true
AGK_ENV=development

# ─── Security ──────────────────────────────────────────────────
# Access PIN for API authentication. Required (8+ chars) in production or
# whenever AGK_SERVER_HOST is not loopback.
AGK_SEC_ACCESS_PIN=

# Allowed CORS origins (comma-separated, empty = no CORS restriction)
# Example: http://localhost:5173,http://localhost:8080
AGK_CORS_ORIGINS=http://localhost:5173

# ─── LLM Provider ──────────────────────────────────────────────
# Primary inference provider (ollama | openrouter | nim | openai | gemini | zai)
AGK_PROVIDER=openrouter
AGK_API_KEY=
AGK_MODEL=qwen3-72b

# ─── OpenRouter (다중 모델聚合) ────────────────────────────────
# https://openrouter.ai/에서 발급
OPENROUTER_API_KEY=

# ─── NVIDIA NIM (build.nvidia.com 무료 API) ────────────────────
# 무료 키 발급: https://build.nvidia.com/ → API Keys (무료, 40rpm/1000req-day)
# 80+ 모델(DeepSeek-R1, Llama 3.1 405B, Nemotron 등)을 무료로 사용 가능
NVIDIA_API_KEY=

# ─── OpenAI 직접 ───────────────────────────────────────────────
# https://platform.openai.com/api-keys에서 발급
# GPT-4o, GPT-4o-mini, o3-mini 등
OPENAI_API_KEY=

# ─── Google Gemini 직접 ────────────────────────────────────────
# https://aistudio.google.com/apikey에서 발급
# Gemini 2.0 Flash, Gemini 2.5 Pro 등
GEMINI_API_KEY=

# ─── ZAI / Zhipu GLM 직접 ──────────────────────────────────────
# https://open.bigmodel.cn/에서 발급
# GLM-4-Plus, GLM-4-Air 등 (한국어 강점)
ZAI_API_KEY=

# ─── Local Model Providers (Ollama / LM Studio / MLX) ─────────
# Ollama는 기본적으로 http://localhost:11434, 키 없이 동작(비워두면 됨)
OLLAMA_API_KEY=
# LM Studio Local Server에서 API 토큰을 활성화한 경우에만 필요
# LM Studio 앱의 Developer 탭에서 발급한 토큰을 입력
LM_STUDIO_API_KEY=
# MLX는 mlx-lm이 모델 저장소를 직접 로드(별도 키 불필요)
AGK_LOCAL_MODEL_PATH=models/
AGK_LOCAL_MODEL=

# ─── RAG / Vector Store ────────────────────────────────────────
AGK_CHROMA_PATH=vault_data/.chroma
AGK_EMBEDDING_MODEL=

# ─── Monitoring ────────────────────────────────────────────────
AGK_LOG_LEVEL=INFO
AGK_LOG_FILE=logs/agent_json.log
AGK_ENABLE_AUDIT=true

# ─── Cost Control ──────────────────────────────────────────────
AGK_DAILY_BUDGET_USD=50.0
AGK_HOURLY_ACTION_LIMIT=100

# ─── GitHub (CI / Benchmark) ───────────────────────────────────
GITHUB_TOKEN=
