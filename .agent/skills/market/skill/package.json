{
  "name": "skill",
  "version": "1.0.2",
  "description": "CLI for installing skill packages into .codebuddy/skills",
  "type": "module",
  "bin": {
    "skill": "./bin/cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md",
    "ThirdPartyNoticeText.txt"
  ],
  "scripts": {
    "build": "node scripts/generate-licenses.ts && obuild",
    "generate-licenses": "node scripts/generate-licenses.ts",
    "dev": "node src/cli.ts",
    "pack:dry-run": "npm publish --dry-run",
    "prepublishOnly": "npm run build",
    "format": "prettier --write 'src/**/*.ts' 'scripts/**/*.ts' 'tests/**/*.ts' '*.md'",
    "format:check": "prettier --check 'src/**/*.ts' 'scripts/**/*.ts' 'tests/**/*.ts' '*.md'",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "skill",
    "cli",
    "skills",
    "skill-installer",
    "codebuddy",
    "agent-skills",
    "npx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonglei100/skill.git"
  },
  "homepage": "https://github.com/tonglei100/skill#readme",
  "bugs": {
    "url": "https://github.com/tonglei100/skill/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "obuild": "^0.4.22",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.17.1"
}
