{
  "name": "antigravity-k-sync",
  "publisher": "antigravity-k",
  "displayName": "Ssak-Ai IDE Sync",
  "description": "Syncs IDE state with Ssak-Ai Local Engine",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "author": "Ssak-Ai contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ssak-comp/Ssak-Ai"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravity-k-sync.showStatus",
        "title": "Ssak-Ai: Show IDE Sync Status"
      }
    ],
    "configuration": {
      "title": "Ssak-Ai IDE Sync",
      "properties": {
        "antigravityK.ideSync.port": {
          "type": "number",
          "default": 54321,
          "minimum": 1,
          "maximum": 65535,
          "description": "Ssak-Ai IDE sync listener port."
        },
        "antigravityK.ideSync.debounceMilliseconds": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "maximum": 5000,
          "description": "Delay used to collapse rapid editor events into one sync request."
        },
        "antigravityK.ideSync.requestTimeoutMilliseconds": {
          "type": "number",
          "default": 1000,
          "minimum": 100,
          "maximum": 30000,
          "description": "IDE sync request timeout."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/vscode": "1.80.0",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vscode/test-electron": "2.5.2",
    "eslint": "8.57.1",
    "mocha": "12.0.0",
    "typescript": "^5.1.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.4.3"
  },
  "overrides": {
    "browserslist": "4.28.8",
    "fast-uri": "3.1.6",
    "serialize-javascript": "7.0.5"
  }
}
